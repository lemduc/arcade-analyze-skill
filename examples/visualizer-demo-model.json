  "failures": [
    {
      "id": 0,
      "component": "recovery",
      "type": "Dependency Cycle",
      "severity": "high",
      "headline": "Circular dependency",
      "description": "recovery and clustering call into each other (recover() drives the algorithms, but the algorithms call back for component naming).",
      "impact": "Changes ripple around the cycle: none of the involved components can be built, tested, or understood in isolation, and a refactor in one forces retesting all of them.",
      "mitigation": "Break the cycle: extract the shared part into its own component, or invert one direction with an interface owned by the callee (dependency inversion).",
      "effort": "medium \u2014 plan across a few PRs",
      "affected": [
        "recovery",
        "clustering"
      ]
    },
    {
      "id": 1,
      "component": "graph",
      "type": "Link Overload",
      "severity": "high",
      "headline": "Link overload (too many connections)",
      "description": "graph is depended on by 8 of 11 components (73% fan-in); nearly every change elsewhere can be affected by its API.",
      "impact": "The component is coupled to a large share of the system; most changes elsewhere can reach it, making it a stability bottleneck.",
      "mitigation": "Reduce fan-in/fan-out: introduce a facade, narrow the API surface, and cut dependencies that only need a small slice of it.",
      "effort": "medium \u2014 plan across a few PRs",
      "affected": [
        "graph"
      ]
    },
    {
      "id": 2,
      "component": "cli",
      "type": "Concern Overload",
      "severity": "medium",
      "headline": "Component owns too many concerns",
      "description": "cli orchestrates ingest, recovery, smells, metrics, visualization and query \u2014 six distinct concerns in one component.",
      "impact": "The component accumulates unrelated responsibilities, so unrelated changes collide in the same place and its API keeps growing.",
      "mitigation": "Split by concern: group entities that change together and move each group behind its own narrow interface.",
      "effort": "low \u2014 localized change",
      "affected": [
        "cli"
      ]
    },
    {
      "id": 3,
      "component": "ingest",
      "type": "Scattered Functionality",
      "severity": "medium",
      "headline": "One concern scattered across components",
      "description": "Path normalization and file filtering logic appears in ingest, parsers and utils rather than in one owner.",
      "impact": "A single responsibility is implemented in several components, so every change to it is a multi-component change and behavior drifts between the copies.",
      "mitigation": "Consolidate the concern into one owning component and have the others depend on it instead of re-implementing it.",
      "effort": "medium \u2014 plan across a few PRs",
      "affected": [
        "ingest",
        "parsers",
        "utils"
      ]
    },
    {
      "id": 4,
      "component": "utils",
      "type": "Link Overload",
      "severity": "low",
      "headline": "Link overload (too many connections)",
      "description": "utils is a grab-bag dependency for 6 components; its helpers have no single concern.",
      "impact": "The component is coupled to a large share of the system; most changes elsewhere can reach it, making it a stability bottleneck.",
      "mitigation": "Reduce fan-in/fan-out: introduce a facade, narrow the API surface, and cut dependencies that only need a small slice of it.",
      "effort": "low \u2014 localized change",
